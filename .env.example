# === Firebase ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === AI / Command Room — 3 model: Lucent, Arete, Noir ===
# JANGAN isi nilai ini di file ini! Salin ke .env.local (tidak di-commit).
#
# OPSI A (paling sederhana) — 1 API key OpenRouter untuk KETIGA model:
# isi DEEPSEEK_API_KEY dengan key OpenRouter (diawali "sk-or-v1-"). Lucent,
# Arete, dan Noir otomatis routing lewat OpenRouter pakai key yang sama.
# DASHSCOPE_API_KEY / ANTHROPIC_API_KEY boleh dikosongkan.
#
# OPSI B — native per-provider (dipakai duluan kalau ada, override opsi A):
DEEPSEEK_API_KEY=your_deepseek_or_openrouter_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Arete → Qwen3.7-Plus native via DashScope (Alibaba Cloud Model Studio).
# Daftar di https://dashscope.console.aliyun.com/ → API Keys. Kosongkan untuk
# pakai OpenRouter (opsi A) via DEEPSEEK_API_KEY di atas.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Noir → model native via Anthropic SDK resmi. Daftar di
# https://console.anthropic.com/ → API Keys. Kosongkan untuk pakai
# OpenRouter (opsi A) via DEEPSEEK_API_KEY di atas.
ANTHROPIC_API_KEY=

# === AI / NVIDIA NIM (Drawing Intelligence) ===
# Dipakai hanya untuk Document Intelligence (OCR, Vision, Parsing gambar kerja).
# Command Room TIDAK memerlukan NVIDIA key.
# Daftar di https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_OCR_V2_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
NVIDIA_DRAWING_FAST_API_KEY=
NVIDIA_DRAWING_PARSE_API_KEY=
NVIDIA_DRAWING_OCR_API_KEY=
NVIDIA_DRAWING_REVIEW_API_KEY=
NVIDIA_DRAWING_FAST_MODEL=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_DRAWING_PARSE_MODEL=nvidia/nemotron-parse
NVIDIA_DRAWING_OCR_MODEL=nvidia/nemotron-ocr-v2
NVIDIA_DRAWING_REVIEW_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# === AI / Gemini (Smart Import, Import Map) ===
# Dipakai untuk fitur Smart Import kolom RAB Excel.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# === Command Room tool-calling (Fase 0, PLAN.md) ===
# Lucent/Arete/Noir memanggil tool nyata (query_rab, query_schedule, lookup_ahsp,
# run_scenario, analyze_drawing) via core-engine/document-intelligence sebelum
# menjawab. "1"/"true" = paksa ON, "0"/"false" = paksa OFF (fallback ke direct-
# stream lama tanpa tools). Kosongkan untuk default: ON kalau CORE_ENGINE_URL terisi.
COMMAND_ROOM_TOOLS_ENABLED=

# === Service URLs ===
CORE_ENGINE_URL=http://localhost:8081
NEXT_PUBLIC_CORE_ENGINE_URL=http://127.0.0.1:8081
AI_ORCHESTRATOR_URL=http://localhost:8082
DOCUMENT_INTELLIGENCE_URL=http://localhost:8083
NEXT_PUBLIC_DOCUMENT_INTELLIGENCE_URL=http://127.0.0.1:8083
DOCUMENT_INTELLIGENCE_PORT=8083

# === Core Engine (v0.6) ===
# Override direktori data AHSP & harga satuan (opsional).
# Default: <repo-root>/data/
PAAX_DATA_DIR=

# === App Config ===
PAAX_ENV=development
PAAX_LOG_LEVEL=info
PAAX_DEFAULT_CURRENCY=IDR
