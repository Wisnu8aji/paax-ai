# === Firebase ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === AI / Command Room — 3 model: Lucent, Arete, Noir ===
# JANGAN isi nilai ini di file ini! Salin ke .env.local (tidak di-commit).
#
# OPSI A (paling sederhana) — 1 API key OpenRouter untuk KETIGA model:
# isi DEEPSEEK_API_KEY dengan key OpenRouter (diawali "sk-or-v1-"). Lucent,
# Arete, dan Noir otomatis routing lewat OpenRouter pakai key yang sama.
# DASHSCOPE_API_KEY / ANTHROPIC_API_KEY boleh dikosongkan.
#
# OPSI B — native per-provider (dipakai duluan kalau ada, override opsi A):
DEEPSEEK_API_KEY=your_deepseek_or_openrouter_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Status "AI sedang berpikir" untuk Lucent/Arete diringkas kontekstual (bukan
# label fase generik) via Mistral Small 3 lewat OpenRouter -- PAKAI KEY YANG
# SAMA dengan DEEPSEEK_API_KEY di atas (harus key OpenRouter "sk-or-v1-...",
# TIDAK perlu key/provider baru). Kalau DEEPSEEK_API_KEY bukan key OpenRouter,
# fitur ini otomatis nonaktif dan fallback ke label fase generik lama -- tidak
# error. Noir tidak terpengaruh (tetap reasoning mentah apa adanya).
# Override slug model kalau perlu, default "mistralai/mistral-small-3.1-24b-instruct".
STATUS_SUMMARY_MODEL=

# Arete → Qwen3.7-Plus native via DashScope (Alibaba Cloud Model Studio).
# Daftar di https://dashscope.console.aliyun.com/ → API Keys. Kosongkan untuk
# pakai OpenRouter (opsi A) via DEEPSEEK_API_KEY di atas.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Noir → model native via Anthropic SDK resmi. Daftar di
# https://console.anthropic.com/ → API Keys. Kosongkan untuk pakai
# OpenRouter (opsi A) via DEEPSEEK_API_KEY di atas.
ANTHROPIC_API_KEY=

# === AI / NVIDIA NIM (Drawing Intelligence) ===
# Dipakai hanya untuk Document Intelligence (OCR, Vision, Parsing gambar kerja).
# Command Room TIDAK memerlukan NVIDIA key (status summary Command Room pakai
# Mistral Small 3 via DEEPSEEK_API_KEY/OpenRouter di atas, lihat STATUS_SUMMARY_MODEL).
# Daftar di https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_OCR_V2_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
NVIDIA_DRAWING_FAST_API_KEY=
NVIDIA_DRAWING_PARSE_API_KEY=
NVIDIA_DRAWING_OCR_API_KEY=
NVIDIA_DRAWING_REVIEW_API_KEY=
NVIDIA_DRAWING_FAST_MODEL=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_DRAWING_PARSE_MODEL=nvidia/nemotron-parse
NVIDIA_DRAWING_OCR_MODEL=nvidia/nemotron-ocr-v2
NVIDIA_DRAWING_REVIEW_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# === AI / Gemini (Smart Import, Import Map) ===
# Dipakai untuk fitur Smart Import kolom RAB Excel.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# === AI / Drawing Intelligence — DEM extraction + PCKM synthesis ===
# Key TERPISAH dari Command Room (DEEPSEEK_API_KEY di atas, dipakai Lucent/
# Arete/Noir) DAN dari NVIDIA Drawing Intelligence lama (baris 31-45).
# Dipakai oleh Fase 2 (DEM job orchestrator, per-halaman vision extraction ke
# DrawingEvidenceSheet, lihat services/document-intelligence/app/transcription/
# providers/qwen.py) DAN Fase 3 (PCKM synthesis escalation ke DeepSeek,
# services/document-intelligence/app/project_graph/providers/deepseek.py).
# Rename dari DEM_EXTRACTION_* (2026-07-14) ke DRAWING_INTELLIGENCE_* pada
# 2026-07-15 supaya jelas mencakup Fase 2 dan Fase 3 sekaligus — bukan cuma
# ekstraksi per-halaman. Command Room dan Drawing Intelligence tetap dua key
# terpisah agar biayanya bisa dihitung sendiri-sendiri; jangan pernah isi
# DRAWING_INTELLIGENCE_API_KEY dengan nilai yang sama dengan DEEPSEEK_API_KEY.
# Isi manual di .env.local, JANGAN commit isinya.
DRAWING_INTELLIGENCE_PROVIDER=
DRAWING_INTELLIGENCE_API_KEY=
DRAWING_INTELLIGENCE_BASE_URL=
# Model per fase (dua nama model berbeda, satu key/base URL bersama):
DRAWING_INTELLIGENCE_QWEN_MODEL=
DRAWING_INTELLIGENCE_DEEPSEEK_MODEL=

# === Command Room tool-calling (Fase 0, PLAN.md) ===
# Lucent/Arete/Noir memanggil tool nyata (query_rab, query_schedule, lookup_ahsp,
# run_scenario) via core-engine/document-intelligence sebelum menjawab.
# analyze_drawing dimatikan 2026-07-14 bersama jalur analisa gambar lama
# (lihat report/ + G:\paax-cleanup-archive\2026-07-14-tkg-drawing-analysis-legacy).
# "1"/"true" = paksa ON, "0"/"false" = paksa OFF (fallback ke direct-stream lama
# tanpa tools). Kosongkan untuk default: ON kalau CORE_ENGINE_URL terisi.
COMMAND_ROOM_TOOLS_ENABLED=

# === Service URLs ===
CORE_ENGINE_URL=http://localhost:8081
NEXT_PUBLIC_CORE_ENGINE_URL=http://127.0.0.1:8081
AI_ORCHESTRATOR_URL=http://localhost:8082
DOCUMENT_INTELLIGENCE_URL=http://localhost:8083
NEXT_PUBLIC_DOCUMENT_INTELLIGENCE_URL=http://127.0.0.1:8083
DOCUMENT_INTELLIGENCE_PORT=8083
DB_API_URL=http://localhost:8001
NEXT_PUBLIC_DB_API_URL=http://127.0.0.1:8001

# === Core Engine (v0.6) ===
# Override direktori data AHSP & harga satuan (opsional).
# Default: <repo-root>/data/
PAAX_DATA_DIR=

# === App Config ===
PAAX_ENV=development
PAAX_LOG_LEVEL=info
PAAX_DEFAULT_CURRENCY=IDR
