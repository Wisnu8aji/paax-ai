# === Firebase ===
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === AI / Gemini ===
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# === AI / DeepSeek ===
# Dipakai Command Room dan Drawing Intelligence.
# Fallback lama jika NVIDIA_API_KEY tidak dipakai.
# Drawing Intelligence -> deepseek-v4-flash tanpa thinking mode.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_FAST=deepseek-v4-flash
DEEPSEEK_MODEL_REASONING=deepseek-v4-pro

# === AI / NVIDIA NIM ===
# Provider utama yang direkomendasikan:
# Lucent -> moonshotai/kimi-k2.6
# Solace -> deepseek-ai/deepseek-v4-pro
# Drawing Intelligence -> deepseek-ai/deepseek-v4-pro
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LUCENT_API_KEY=
NVIDIA_KIMI_API_KEY=
NVIDIA_SOLACE_API_KEY=
NVIDIA_DEEPSEEK_API_KEY=
NVIDIA_DRAWING_FAST_API_KEY=
NVIDIA_DRAWING_PARSE_API_KEY=
NVIDIA_DRAWING_OCR_API_KEY=
NVIDIA_OCR_API_KEY=
NVIDIA_DRAWING_REVIEW_API_KEY=
NVIDIA_OCR_V2_URL=https://ai.api.nvidia.com/v1/cv/nvidia/nemotron-ocr-v2
NVIDIA_LUCENT_MODEL=moonshotai/kimi-k2.6
NVIDIA_SOLACE_MODEL=deepseek-ai/deepseek-v4-pro
NVIDIA_LUCENT_TIMEOUT_MS=120000
NVIDIA_SOLACE_TIMEOUT_MS=120000
NVIDIA_DRAWING_FAST_MODEL=nvidia/nemotron-nano-12b-v2-vl
NVIDIA_DRAWING_PARSE_MODEL=nvidia/nemotron-parse
NVIDIA_DRAWING_OCR_MODEL=nvidia/nemotron-ocr-v2
NVIDIA_DRAWING_REVIEW_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# === Service URLs ===
CORE_ENGINE_URL=http://localhost:8081
NEXT_PUBLIC_CORE_ENGINE_URL=http://127.0.0.1:8081
AI_ORCHESTRATOR_URL=http://localhost:8082
DOCUMENT_INTELLIGENCE_URL=http://localhost:8083
NEXT_PUBLIC_DOCUMENT_INTELLIGENCE_URL=http://127.0.0.1:8083
DOCUMENT_INTELLIGENCE_PORT=8083

# === Core Engine (v0.6) ===
# Override direktori data AHSP & harga satuan (opsional).
# Default: <repo-root>/data/
PAAX_DATA_DIR=

# === App Config ===
PAAX_ENV=development
PAAX_LOG_LEVEL=info
PAAX_DEFAULT_CURRENCY=IDR
