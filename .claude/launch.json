{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "paax-web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set PATH=C:\\Program Files\\nodejs;%APPDATA%\\npm;%PATH% && pnpm --dir apps/web dev"
      ],
      "port": 3000
    },
    {
      "name": "paax-doc-intel",
      "runtimeExecutable": "python",
