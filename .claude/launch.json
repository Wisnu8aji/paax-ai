      "cwd": "services/document-intelligence",
      "port": 8083
    },
    {
      "name": "paax-core-engine",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8081"],
      "cwd": "services/core-engine",
      "port": 8081
    }
  ]
}
