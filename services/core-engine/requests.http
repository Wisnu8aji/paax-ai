Content-Type: application/json

{
  "project_context": {"prj_id": "PRJ-BOE", "mode": "estimate", "tipe_bangunan": "rumah", "wilayah": "jateng"},
  "assumptions": [
    {"id": "A1", "kategori": "metode", "deskripsi": "tinggi lantai dari user"},
    {"id": "A2", "kategori": "data", "deskripsi": "harga belum lengkap"}
